# Copy to .env for local development.
# Never commit real credentials or secrets.

# Optional local read-only capability. Use narrow roots.
# Windows uses ; as the separator, Linux/macOS use :.
UTA_LOCAL_ROOTS=

# Optional browser capability. Disabled unless explicitly enabled.
UTA_BROWSER_ENABLED=false
UTA_BROWSER_ALLOWED_HOSTS=

# Optional programming execution. Requires Docker and an immutable image digest.
UTA_PYTHON_SANDBOX_ENABLED=false
UTA_SANDBOX_IMAGE=

# Programming workspace context reuses explicit local roots; no implicit home-directory access.
